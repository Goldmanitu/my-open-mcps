# Copy to a private environment outside Git and replace the bot-token placeholder.
# On macOS, ChatGPT can discover and store TELEGRAM_CHAT_ID during setup.
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# TELEGRAM_CHAT_ID=replace-with-numeric-chat-id

# Optional settings:
# TELEGRAM_ALERT_STATE_PATH=/absolute/private/path/telegram-alerts.sqlite3
# TELEGRAM_ALERT_TIMEOUT_SECONDS=15
# TELEGRAM_ALERT_PROTECT_CONTENT=true
